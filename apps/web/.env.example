# Firebase (client SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# MongoDB (serverless API — set in .env.local for vercel dev, set in Vercel dashboard for production)
MONGO_URL=
MONGO_DB=

# Firebase Admin SDK (single-line JSON string of service account key)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
